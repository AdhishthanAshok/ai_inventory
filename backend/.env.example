# Environment mode ('production' on Vercel)
ENVIRONMENT=production

# Database (MongoDB Atlas connection string)
MONGODB_URL=mongodb+srv://adhishthan123:XXXXXXXXXXXXXXX@XXXXXXX..mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=ai_inventory

# JWT Authentication
SECRET_KEY=your_super_secret_jwt_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cloudinary (Required for image storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Gemini API (Required for AI outfit recommendation)
GEMINI_API_KEY=your_gemini_api_key

# Frontend & CORS (comma-separated origins allowed to access the API)
FRONTEND_URL=https://ai-inventory-nu.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://ai-inventory-nu.vercel.app
